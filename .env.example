# Database
DATABASE_URL=""
DIRECT_URL="postgresql://user:pass@host:5432/db?schema=public"

# Auth.js
AUTH_SECRET=""

# Abuse protection (Upstash Redis REST)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Password reset email (Resend)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Faura-Farmer <security@example.com>"

# OAuth providers
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Mobile API: leave disabled outside local development and Vercel Preview.
# Never configure this on Production. MOBILE_AUTH_SECRET must be a separate,
# 32+-character staging secret when mobile Preview is enabled.
MOBILE_API_ENABLED="false"
MOBILE_AUTH_SECRET=""

# Private Supabase Storage bucket for receipt images. Never expose the service role key to the client.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET=""

# OAuth buttons only render when their matching provider credentials are set
# and these public flags are explicitly enabled.
NEXT_PUBLIC_GOOGLE_ENABLED="false"
NEXT_PUBLIC_FACEBOOK_ENABLED="false"
