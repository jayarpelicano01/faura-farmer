{
  "expo": {
    "name": "Faura Farmer",
    "slug": "faura-farmer",
    "scheme": "faurafarmer",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/AlbertSans-Variable.ttf",
            "./assets/fonts/Unbounded-Variable.ttf"
          ]
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Allow Faura Farmer to unlock your financial data."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Faura Farmer to unlock your financial data."
        }
      ],
      "expo-sqlite"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.faura.farmer.preview"
    },
    "android": {
      "package": "com.faura.farmer",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#030B26"
      },
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5f8a3f2c-59e9-4d12-8fb7-36a01177f616"
      }
    },
    "owner": "jayaruuu"
  }
}
