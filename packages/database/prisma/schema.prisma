generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AuthProvider {
  email
  google
  facebook
}

enum AccountType {
  bank
  e_wallet
  cash
  credit_card
  investment
}

enum CategoryType {
  income
  expense
}

enum BudgetBucket {
  needs
  wants
  savings
}

enum TransactionType {
  income
  expense
  transfer
}

enum TransferRole {
  outgoing
  incoming
}

enum Frequency {
  weekly
  monthly
  yearly
}

model User {
  id             String       @id @default(uuid()) @db.Uuid
  email          String       @unique
  passwordHash   String?      @map("password_hash")
  authProvider   AuthProvider @default(email) @map("auth_provider")
  providerId     String?      @map("provider_id")
  name           String?      @map("name")
  username       String?      @unique @map("username")
  avatarUrl      String?      @map("avatar_url")
  sessionVersion Int          @default(0) @map("session_version")
  displayCurrency String      @default("PHP") @map("display_currency")
  usdPerPhp       Decimal?    @map("usd_per_php") @db.Decimal(20, 10)
  rateDate        DateTime?   @map("rate_date") @db.Date
  rateRefreshedAt DateTime?   @map("rate_refreshed_at") @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  accounts            Account[]
  categories          Category[]
  budgets             Budget[]
  goals               Goal[]
  monthlyBudget       MonthlyBudget?
  passwordResetTokens PasswordResetToken[]
  securityEvents      SecurityEvent[]
  oauthIdentities     OAuthIdentity[]
  oauthLinkIntents    OAuthLinkIntent[]
  mobileSessions      MobileSession[]
  mobileSyncChanges   MobileSyncChange[]
  mobileMutations     MobileMutation[]

  @@unique([authProvider, providerId])
  @@map("users")
}

model OAuthIdentity {
  id                String       @id @default(uuid()) @db.Uuid
  userId            String       @map("user_id") @db.Uuid
  provider          AuthProvider
  providerAccountId String       @map("provider_account_id")
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_identities")
}

model OAuthLinkIntent {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  provider  AuthProvider
  expiresAt DateTime     @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime?    @map("used_at") @db.Timestamptz(6)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, provider, expiresAt])
  @@map("oauth_link_intents")
}

model Account {
  id                String      @id @default(uuid()) @db.Uuid
  userId            String      @map("user_id") @db.Uuid
  label             String
  type              AccountType
  institution       String?
  externalAccountId String?     @map("external_account_id")
  currency          String      @default("PHP")
  startingBalance   Decimal     @default(0) @map("starting_balance") @db.Decimal(14, 2)
  color             String?
  icon              String?
  isArchived        Boolean     @default(false) @map("is_archived")
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions   Transaction[]
  recurringRules RecurringRule[]

  @@index([userId])
  @@unique([id, userId])
  @@map("accounts")
}

model Category {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  name      String
  type      CategoryType
  icon      String?
  color     String?
  bucket    BudgetBucket?
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions     Transaction[]
  budgets          Budget[]
  recurringRules   RecurringRule[]

  @@index([userId])
  @@unique([id, userId])
  @@map("categories")
}

model Transaction {
  id                    String          @id @default(uuid()) @db.Uuid
  accountId             String          @map("account_id") @db.Uuid
  userId                String          @map("user_id") @db.Uuid
  categoryId            String?         @map("category_id") @db.Uuid
  bucket                BudgetBucket?
  amount                Decimal         @db.Decimal(14, 2)
  type                  TransactionType
  transferGroupId       String?         @map("transfer_group_id") @db.Uuid
  transferRole          TransferRole?   @map("transfer_role")
  date                  DateTime        @db.Date
  note                  String?
  source                String          @default("manual")
  externalTransactionId String?         @map("external_transaction_id")
  recurringRuleId       String?         @map("recurring_rule_id") @db.Uuid
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  account  Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([accountId])
  @@index([date])
  @@index([accountId, date])
  @@index([accountId, type, date])
  @@index([accountId, transferRole, transferGroupId])
  @@index([userId, date])
  @@index([transferGroupId])
  @@unique([id, userId])
  @@unique([transferGroupId, transferRole])
  @@map("transactions")
}

model RecurringRule {
  id          String    @id @default(uuid()) @db.Uuid
  accountId   String    @map("account_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  categoryId  String?   @map("category_id") @db.Uuid
  label       String?
  amount      Decimal   @db.Decimal(14, 2)
  type        TransactionType @default(expense)
  frequency   Frequency
  nextDueDate DateTime  @map("next_due_date") @db.Date
  isActive    Boolean   @default(true) @map("is_active")

  account  Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([accountId])
  @@index([userId])
  @@index([userId, isActive, nextDueDate])
  @@unique([id, userId])
  @@map("recurring_rules")
}

model Budget {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  categoryId   String   @map("category_id") @db.Uuid
  monthlyLimit Decimal  @map("monthly_limit") @db.Decimal(14, 2)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId])
  @@index([userId])
  @@map("budgets")
}

model Goal {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  name          String
  targetAmount  Decimal   @map("target_amount") @db.Decimal(14, 2)
  currentAmount Decimal   @default(0) @map("current_amount") @db.Decimal(14, 2)
  targetDate    DateTime? @map("target_date") @db.Date

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("goals")
}

model MonthlyBudget {
  id     String  @id @default(uuid()) @db.Uuid
  userId String  @map("user_id") @db.Uuid
  amount Decimal @db.Decimal(14, 2)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@map("monthly_budgets")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model SecurityEvent {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String?   @map("user_id") @db.Uuid
  event     String
  ipHash    String?   @map("ip_hash")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([event, createdAt])
  @@map("security_events")
}

/// Refresh sessions are mobile-only. The opaque refresh token is never stored;
/// `tokenHash` contains a SHA-256 digest and is replaced on every refresh.
model MobileSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  deviceId  String    @map("device_id")
  sessionVersion Int  @default(0) @map("session_version")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  lastUsedAt DateTime @default(now()) @map("last_used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, deviceId, expiresAt])
  @@map("mobile_sessions")
}

/// Monotonic, per-user-filtered change feed. Tombstones carry no payload and
/// protect clients from reviving records deleted on another device.
model MobileSyncChange {
  cursor    BigInt   @id @default(autoincrement()) @db.BigInt
  userId    String   @map("user_id") @db.Uuid
  entity    String
  recordId  String   @map("record_id") @db.Uuid
  operation String
  data      Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, cursor])
  @@index([userId, entity, recordId, cursor])
  @@map("mobile_sync_changes")
}

/// Durable idempotency receipts for a device mutation. Responses are recorded
/// in the same transaction as the associated domain and change-log writes.
model MobileMutation {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  clientMutationId String   @map("client_mutation_id") @db.Uuid
  result           Json
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clientMutationId])
  @@index([userId, createdAt])
  @@map("mobile_mutations")
}
