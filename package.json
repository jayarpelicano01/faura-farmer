{
  "name": "faura-farmer",
  "version": "0.1.0",
  "private": true,
  "description": "Faura-Farmer — personal finance tracker monorepo",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @faura-farmer/web dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @faura-farmer/database db:generate",
    "db:push": "pnpm --filter @faura-farmer/database db:push",
    "db:migrate": "pnpm --filter @faura-farmer/database db:migrate",
    "db:studio": "pnpm --filter @faura-farmer/database db:studio"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}