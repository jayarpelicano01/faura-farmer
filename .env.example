# Database
DATABASE_URL="postgresql://user:pass@host:5432/db?schema=public"
DIRECT_URL="postgresql://user:pass@host:5432/db?schema=public"

# Auth.js
AUTH_SECRET="generate-with-openssl-rand-base64-32"

# Abuse protection (Upstash Redis REST)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Password reset email (Resend)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Faura-Farmer <security@example.com>"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# OAuth buttons will only render when these are set
NEXT_PUBLIC_GOOGLE_ENABLED="false"
NEXT_PUBLIC_FACEBOOK_ENABLED="false"
