{
  "build": {
    "preview": {
      "distribution": "internal",
      "env": {
        "FAURA_APP_MODE": "online"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "distribution": "internal",
      "env": {
        "FAURA_APP_MODE": "online",
        "EXPO_PUBLIC_API_URL": "https://faura-farmer.vercel.app",
        "FAURA_APK_VARIANT": "arm64"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production-compat": {
      "extends": "production",
      "env": {
        "FAURA_APP_MODE": "online",
        "EXPO_PUBLIC_API_URL": "https://faura-farmer.vercel.app",
        "FAURA_APK_VARIANT": "compat"
      }
    },
    "offline-friends": {
      "distribution": "internal",
      "developmentClient": false,
      "env": {
        "FAURA_APP_MODE": "offline",
        "FAURA_APK_VARIANT": "arm64"
      },
      "android": {
        "buildType": "apk"
      }
    }
  }
}
