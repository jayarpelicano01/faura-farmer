# Database
DATABASE_URL=""
DIRECT_URL="postgresql://user:pass@host:5432/db?schema=public"

# Auth.js
AUTH_SECRET=""

# Abuse protection (Upstash Redis REST)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# OAuth providers
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# OAuth buttons only render when their matching provider credentials are set
# and these public flags are explicitly enabled.
NEXT_PUBLIC_GOOGLE_ENABLED="false"
NEXT_PUBLIC_FACEBOOK_ENABLED="false"
