{
  "name": "@faura-farmer/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@faura-farmer/config": "workspace:*",
    "@faura-farmer/types": "workspace:*",
    "@react-native-community/netinfo": "11.5.2",
    "expo": "~55.0.18",
    "expo-build-properties": "~55.0.18",
    "expo-constants": "~55.0.17",
    "expo-crypto": "~55.0.19",
    "expo-document-picker": "~55.0.17",
    "expo-file-system": "~55.0.26",
    "expo-font": "~55.0.8",
    "expo-linking": "~55.0.17",
    "expo-local-authentication": "~55.0.18",
    "expo-router": "~55.0.17",
    "expo-secure-store": "~55.0.18",
    "expo-sharing": "~55.0.24",
    "expo-sqlite": "~55.0.20",
    "lucide-react-native": "^1.39.0",
    "nativewind": "^4.1.23",
    "react": "19.2.0",
    "react-native": "0.83.0",
    "react-native-css-interop": "0.2.6",
    "react-native-gifted-charts": "^1.4.78",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "^15.15.5",
    "react-native-worklets": "0.7.4"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.0",
    "jest": "~29.7.0",
    "jest-expo": "~55.0.22",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/test/setup.ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "\\.css$": "<rootDir>/test/style-mock.js"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(.pnpm|(jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg))"
    ]
  }
}
